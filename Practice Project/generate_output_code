	if (mut_count_file != ""){
		mutnum = sim.mutations.size();
		writeFile(mut_count_file, sim.cycle + "," + mutnum, append=T);
	}    
}

//mutavg
if (mut_avg_file!="") {
	pop=p1.individualCount;
	mut=sum(p1.individuals.uniqueMutations.size());
	mut_avg=mut/pop;
	writeFile(mut_avg_file, sim.cycle+","+pop+","+mut_avg, append=T);
}

//driver
if (driver_track_file != "") {

		inds = p1.individuals;
		
		counts = inds.countOfMutationsOfType(m2);
		hasDriver = counts > 0; //logical
		numWithDrivers = sum(hasDriver);
		
		if (numWithDrivers > 0) {
		carriers = inds[hasDriver];
		//applyValue takes value of current element in carriers, in this case, individual
		sSums = sapply(carriers, "sum(applyValue.uniqueMutationsOfType(m2).selectionCoeff);");
		avgS = mean(sSums);
		maxS = max(sSums);} else {
			avgS = 0.0;
			maxS = 0.0;
		}
		
		pop = p1.individualCount;
		fracWithDrivers = numWithDrivers/pop;
		numSegregating = size(sim.mutationsOfType(m2));

		writeFile(driver_track_file, sim.cycle+","+numWithDrivers+","+fracWithDrivers+","+avgS+","+maxS+","+numSegregating, append=T);
}
