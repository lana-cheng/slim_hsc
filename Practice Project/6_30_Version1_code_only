initialize() {
	initializeSLiMModelType("nonWF");
	
	if (!exists("K")) {
		defineConstant("K", 1000);	// population size equilibrium
	}
	
	//initial population size
	defineConstant("initialpop", 100);

    // neutral mutations, which are allowed to fix
	initializeMutationType("m1", 0.5, "f", 0.0);
	m1.convertToSubstitution = T;
	
	initializeGenomicElementType("g1", m1, 1.0);
	
    //Length of chromosome
	defineConstant("length", 100000000);
	initializeGenomicElement(g1, 0, length-1);
	
	//Mutation rate: mutations per division
	defineConstant("mutrate", 16.8);
	
	//mutation rate adjusted for genome length per base position for a diploid cell. mutation/base pair in one divsion
	initializeMutationRate(mutrate/(length*2));
	
	//No recombination
	initializeRecombinationRate(0);
	
	//age
	defineConstant("age", 30);
	
	//probability of a cell undergoing division this tick
	defineConstant("pdiv", 0.00273);
	
	//differentiation type probability
	defineConstant("psym", 0.6);
	defineConstant("pasym", 0.2);
	defineConstant("pdiff", 0.2);
}

// create an initial population
1 early() {
	sim.addSubpop("p1", initialpop);
}

2: first() {

//determine which cells are dividing this tick/day
N=p1.individualCount;
p1.individuals.tag=rbinom(N,1,pdiv);

//calculate psym and pdiff based on population size
psum=psym+pdiff;
defineGlobal("pdiff_adjusted", min(psum,abs((N/K)*(psum/2)))); //caps probability psum so values are non-negative. Pdiff will always be non-zero, however, psym becomes zero when N=2K. 
defineGlobal("psym_adjusted", psum-pdiff_adjusted);
}

//Kill off parent individuals who were tagged to reproduce
2:early() {
	sim.killIndividuals(p1.individuals[p1.individuals.tag == -1]);
}

// three possible fates: symmetric, asymmetric, symmetric differentiation
reproduction() {
	if (individual.tag == 0)
		return;
	
	division=sample(c("sym", "asym", "diff"), 1, weights=c(psym_adjusted,pasym,pdiff_adjusted));
	
	if (division=="sym") {
		p1.addCloned(individual, 2);
	}
		
	if (division=="asym") {
		p1.addCloned(individual,1);
	}
	
	//No new HSC is added for diff
	
	//Mark parent individual to be killed later
	individual.tag=-1;
}

//Offspring created during reproduction of the tick cycle don't have a tag value so we need to add one here. 2:early() event will return error otherwise because not all individuals have a tag. 
modifyChild() {
	child.tag=0;
    return T;
}

age*365 late() { 
    sim.simulationFinished();
}